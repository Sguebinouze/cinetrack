generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
}

model Media {
  id           Int      @id @default(autoincrement())
  tmdbId       Int      @unique
  mediaType    String
  title        String
  posterPath   String?
  backdropPath String?
  overview     String?
  releaseDate  String?
  genres       String?
  runtime      Int?
  voteAverage  Float?
  director     String?
  isAnime      Boolean  @default(false)
  tvmazeId     Int?
  createdAt    DateTime @default(now())

  watchEntry WatchEntry?
  seasons    Season[]
  listItems  CustomListItem[]
}

model WatchEntry {
  id            Int       @id @default(autoincrement())
  mediaId       Int       @unique
  media         Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  status        String
  rating        Float?
  reviewPrivate String?
  reviewPublic  String?
  watchedAt     DateTime?
  addedAt       DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

model Season {
  id           Int       @id @default(autoincrement())
  mediaId      Int
  media        Media     @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  seasonNumber Int
  name         String?
  episodeCount Int?
  episodes     Episode[]

  @@unique([mediaId, seasonNumber])
}

model Episode {
  id            Int       @id @default(autoincrement())
  seasonId      Int
  season        Season    @relation(fields: [seasonId], references: [id], onDelete: Cascade)
  episodeNumber Int
  name          String?
  airDate       String?
  airstamp      String?
  watched       Boolean   @default(false)
  watchedAt     DateTime?
  rating        Float?

  @@unique([seasonId, episodeNumber])
}

model CustomList {
  id        Int              @id @default(autoincrement())
  name      String
  createdAt DateTime         @default(now())
  items     CustomListItem[]
}

model CustomListItem {
  id      Int        @id @default(autoincrement())
  listId  Int
  list    CustomList @relation(fields: [listId], references: [id], onDelete: Cascade)
  mediaId Int
  media   Media      @relation(fields: [mediaId], references: [id], onDelete: Cascade)
  addedAt DateTime   @default(now())

  @@unique([listId, mediaId])
}

// ── Programme TV (TNT française) ────────────────────────────
// Miroir local de xmltvfr.fr, peuplé uniquement par scripts/import-tv-guide.mjs.
// Donnée de flux sur une fenêtre glissante J-2 → J+4 : aucune relation avec
// Media / WatchEntry, elle est réimportée en entier chaque nuit.

model TvChannel {
  id       String @id // identifiant XMLTV (« TF1.fr »)
  name     String
  logo     String?
  position Int    @default(0) // ordre des canaux TNT, TF1 = 0

  programs TvProgram[]
}

model TvProgram {
  id           Int       @id @default(autoincrement())
  channelId    String
  channel      TvChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  startsAt     String // ISO 8601 avec décalage
  endsAt       String?
  day          String // jour de GRILLE : avant 5h ⇒ soirée de la veille
  title        String
  subTitle     String?
  description  String?
  categories   String? // tableau JSON
  imageUrl     String?
  year         Int?
  director     String?
  actors       String? // tableau JSON
  episodeLabel String? // « S3E4 »
  csa          String?

  @@unique([channelId, startsAt])
  @@index([day, channelId, startsAt])
}
